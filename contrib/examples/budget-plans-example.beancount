option "title" "Budget and Project Plans"
option "operating_currency" "USD"
plugin "beancount.plugins.auto_accounts"

2026-01-01 custom "budget" Expenses:Food:Groceries "monthly" 650 USD
2026-01-01 custom "budget" Expenses:Food:Restaurants "monthly" 250 USD
2026-01-01 custom "budget" Expenses:Transport "monthly" 180 USD

2026-01-01 custom "budget-plan" "kitchen" Expenses:Projects:Kitchen 20000 USD
  name: "Kitchen remodel"
  end: 2026-12-31

2026-01-01 custom "budget-plan" "kitchen-cabinets" Expenses:Projects:Kitchen:Cabinets 8000 USD
  parent: "kitchen"
  name: "Cabinets"

2026-03-01 custom "budget-plan" "kitchen-appliances" Expenses:Projects:Kitchen:Appliances 5000 USD
  parent: "kitchen"
  name: "Appliances"
  end: 2026-10-31

2026-11-01 custom "budget-plan" "holiday" Expenses:Projects:Holiday 3500 USD
  name: "Winter holiday"
  end: 2027-02-28

2026-01-01 custom "budget-plan" "tax-prep" Expenses:Projects:TaxPrep 600 USD
  name: "Tax preparation"
  end: 2026-03-31

